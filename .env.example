# Copia este archivo como .env y rellena los valores de tu proyecto Supabase.
# Sin estas variables la app sigue funcionando con almacenamiento local.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Tabla esperada (SQL para el editor de Supabase):
#
#   create table announcements (
#     id uuid primary key default gen_random_uuid(),
#     title text not null,
#     category text not null default 'importante',
#     content text,
#     image_url text,
#     created_at timestamptz not null default now()
#   );
#
#   alter table announcements enable row level security;
#
#   -- Lectura para cualquiera con la anon key:
#   create policy "lectura publica" on announcements for select using (true);
#
#   -- OJO: escribir con la anon key permite publicar a cualquiera que la tenga.
#   -- Para producción, restringir insert/delete a usuarios autenticados.
#   create policy "escritura anon (solo pruebas)" on announcements
#     for all using (true) with check (true);
