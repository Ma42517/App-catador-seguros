# Copia este archivo como .env y rellena los valores de tu proyecto Supabase.
# Sin estas variables la app sigue funcionando con almacenamiento local.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ---------------------------------------------------------------------------
# Tabla esperada (SQL para el editor de Supabase):
#
#   create table if not exists public.announcements (
#     id uuid primary key default gen_random_uuid(),
#     title text not null,
#     category text not null default 'importante',
#     content text,
#     image_url text,
#     created_at timestamptz not null default now()
#   );
#
# ---------------------------------------------------------------------------
# PERMISOS. Sin esto la app recibe "permission denied for table announcements"
# (código 42501), aunque la tabla exista y las credenciales sean correctas.
# Hacen falta LAS DOS COSAS: el GRANT a nivel de Postgres y las políticas RLS.
#
#   -- 1) Privilegios de Postgres. OJO: hacen falta LOS DOS ROLES.
#   --
#   -- Este es el error que más cuesta encontrar. Al iniciar sesión, el rol de
#   -- Postgres de la petición cambia de `anon` a `authenticated`, así que una
#   -- tabla concedida sólo a `anon` se lee desde una pestaña sin sesión y falla
#   -- justo cuando el usuario entra: "permission denied for table" con código
#   -- 42501, y las políticas de RLS parecen correctas porque lo están. El
#   -- permiso que falta es este, no una policy.
#   grant usage on schema public to anon, authenticated;
#   grant select, insert, update, delete on public.announcements
#     to anon, authenticated;
#
#   -- 2) Row Level Security y sus políticas
#   alter table public.announcements enable row level security;
#
#   create policy "lectura publica"
#     on public.announcements for select using (true);
#
#   -- ESCRITURA: SÓLO PROMOTORES Y ADMINISTRADORES.
#   --
#   -- Las políticas de prueba eran `with check (true)`, es decir, cualquiera con
#   -- la llave pública podía publicar en el muro de la promotoría desde la
#   -- consola del navegador. Esconder el botón en la interfaz no lo impide: la
#   -- API está abierta a quien la llame. Esto es lo que de verdad lo cierra.
#   drop policy if exists "escritura pruebas" on public.announcements;
#   drop policy if exists "edicion pruebas" on public.announcements;
#   drop policy if exists "borrado pruebas" on public.announcements;
#
#   create policy "promotores publican" on public.announcements
#     for insert to authenticated
#     with check (public.my_role() in ('promoter', 'admin'));
#
#   create policy "promotores editan" on public.announcements
#     for update to authenticated
#     using (public.my_role() in ('promoter', 'admin'));
#
#   create policy "promotores borran" on public.announcements
#     for delete to authenticated
#     using (public.my_role() in ('promoter', 'admin'));
#
#   -- El asesor sigue leyendo: la política de lectura pública no se toca.
#
#   -- OJO: `public.my_role()` es la función SECURITY DEFINER definida más abajo,
#   -- en el apartado de perfiles. Si todavía no existe, créala primero o estas
#   -- tres políticas fallarán al crearse.
#
# ---------------------------------------------------------------------------
# NOTIFICACIONES PRIORITARIAS CON CONFIRMACION (RSVP)
#
# Un comunicado puede ir al muro -donde espera a que alguien entre- o a la
# pantalla de inicio del asesor, donde NO se va hasta que contesta si asiste o no.
# Por eso lleva fecha y hora: la respuesta es una confirmacion de asistencia.
#
#   -- 1) Destino y datos del evento
#   alter table public.announcements
#     add column if not exists target_section text default 'workspace',
#     add column if not exists event_date date,
#     add column if not exists event_time time;
#
#   -- 2) Las respuestas, una por asesor y alerta.
#   -- En su propia tabla y no en una columna del comunicado porque con veinte
#   -- asesores hay veinte respuestas para la misma alerta, y eso no cabe en una
#   -- fila.
#   create table if not exists public.alert_responses (
#     id         uuid primary key default gen_random_uuid(),
#     alert_id   bigint not null references public.announcements(id) on delete cascade,
#     asesor_id  uuid   not null references public.profiles(id) on delete cascade,
#     response   text   not null check (response in ('yes', 'no')),
#     created_at timestamptz not null default now(),
#     -- Una sola respuesta por persona y alerta. Sin esto, un doble toque crea dos
#     -- filas y el seguimiento contaria a la misma persona en dos columnas.
#     unique (alert_id, asesor_id)
#   );
#
#   create index if not exists alert_responses_alert_idx
#     on public.alert_responses (alert_id);
#
#   -- OJO con el tipo de alert_id: `announcements.id` es bigint (identity), no
#   -- uuid. Declararlo uuid aqui hace fallar la clave ajena al crearla.
#
#   alter table public.alert_responses enable row level security;
#
#   grant usage on schema public to authenticated;
#   grant select, insert on public.alert_responses to authenticated;
#
#   -- 3) Politicas.
#   -- El asesor inserta SU respuesta -asesor_id tiene que ser el suyo, o podria
#   -- contestar en nombre de un compañero- y lee las suyas para que la alerta no
#   -- reaparezca.
#   drop policy if exists "el asesor responde" on public.alert_responses;
#   create policy "el asesor responde" on public.alert_responses
#     for insert to authenticated
#     with check (asesor_id = auth.uid());
#
#   drop policy if exists "el asesor lee sus respuestas" on public.alert_responses;
#   create policy "el asesor lee sus respuestas" on public.alert_responses
#     for select to authenticated
#     using (asesor_id = auth.uid());
#
#   -- Y quien opera la promotoria lee todas las de sus alertas. `my_wall()` cubre
#   -- al titular y a su asistente con una sola condicion.
#   drop policy if exists "la promotoria lee las respuestas" on public.alert_responses;
#   create policy "la promotoria lee las respuestas" on public.alert_responses
#     for select to authenticated
#     using (
#       exists (
#         select 1 from public.announcements a
#          where a.id = alert_responses.alert_id
#            and a.promotor_id = public.my_wall()
#       )
#     );
#
# TIEMPO REAL EN EL SEGUIMIENTO (opcional pero recomendado)
#
# El panel del promotor se suscribe a los cambios de alert_responses para que las
# confirmaciones aparezcan mientras mira, sin cerrar y abrir. Supabase solo emite
# eventos de las tablas que estan en la publicacion, asi que hay que anadirla:
#
#   alter publication supabase_realtime add table public.alert_responses;
#
# Si no se anade, no se rompe nada: el panel sigue leyendo las respuestas al abrir
# cada alerta, solo que no se actualiza solo.
#
# LA AGENDA DEL ASESOR NO ES UNA TABLA
#
# Al confirmar "si asistire", el evento se apunta en su agenda LOCAL
# (localStorage, via EventContext), no en Supabase: no existe tabla de citas y la
# agenda siempre ha vivido en el telefono de cada quien. Se apunta donde de verdad
# la va a consultar, en lugar de en un registro que nadie lee.
#
# ---------------------------------------------------------------------------
# ASISTENTE DE PROMOTORIA
#
# Opera el dia a dia del equipo -aprueba solicitudes, publica en el muro, ve la
# actividad- pero no toca la configuracion maestra: no ve ni cambia el codigo de
# invitacion, y no puede nombrar a otros asistentes.
#
# El rol se guarda como 'assistant', en ingles como los demas ('advisor',
# 'promoter'). La columna `role` es texto libre, asi que no hace falta ningun
# ALTER: basta con que el valor coincida con el que usa el codigo. Escribirlo en
# espanol dejaria al asistente sin acceso y sin ningun error que lo explique.
#
#   -- Nombrar un asistente a mano (lo normal es hacerlo desde la app):
#   update public.profiles
#      set role = 'assistant',
#          promotor_id = 'UUID-DEL-TITULAR',
#          promotoria_status = 'approved'
#    where email = 'asistente@ejemplo.com';
#
# ASCENSO DESDE LA APP
#
# El titular escribe un correo y la app llama a esta funcion. Hace falta una
# funcion y no un update por dos motivos: el cliente no puede buscar una ficha por
# correo -RLS no le deja ver fichas ajenas, y consultarlas por correo permitiria
# averiguar quien esta registrado- ni escribir en una fila que todavia no le
# pertenece, porque la politica del promotor solo alcanza a quien ya tiene su
# promotor_id.
#
#   create or replace function public.promote_to_assistant(p_email text)
#     returns table (assistant uuid, nombre text)
#     language plpgsql security definer set search_path = public
#   as $$
#   declare v_id uuid; v_name text; v_caller text;
#   begin
#     -- La comprobacion vive aqui y no en la interfaz: cualquiera puede invocar la
#     -- funcion desde la consola del navegador.
#     select role into v_caller from public.profiles where id = auth.uid();
#     if v_caller <> 'promoter' then raise exception 'NO_AUTORIZADO'; end if;
#
#     select p.id, coalesce(nullif(p.full_name, ''), p.email)
#       into v_id, v_name
#       from public.profiles p
#      where lower(p.email) = lower(trim(p_email))
#      limit 1;
#
#     if v_id is null then raise exception 'NO_EXISTE'; end if;
#     if v_id = auth.uid() then raise exception 'ES_TU_CUENTA'; end if;
#
#     update public.profiles
#        set role = 'assistant',
#            promotor_id = auth.uid(),
#            promotoria_status = 'approved'
#      where id = v_id;
#
#     return query select v_id, v_name;
#   end $$;
#
#   grant execute on function public.promote_to_assistant(text) to authenticated;
#
# Quitarle el puesto NO necesita funcion: la ficha ya tiene el promotor_id de quien
# llama, asi que la politica "promotores gestionan su equipo" la alcanza. La app
# solo le devuelve el rol de asesor y le conserva el vinculo, para no echarlo del
# equipo sin que nadie lo pidiera.
#
# ---------------------------------------------------------------------------
# CADA MURO CON SUS COMUNICADOS (multi-promotoria)
#
# La tabla `announcements` nacio como un tablon unico para toda la app. En cuanto
# hay dos promotorias, cada asesor lee los comunicados de la otra -campanas,
# bases, cifras- y nadie lo nota porque la pantalla se ve normal.
#
#   -- 1) El dueno de cada comunicado
#   alter table public.announcements
#     add column if not exists promotor_id uuid
#       references public.profiles(id) on delete cascade;
#
#   create index if not exists announcements_promotor_id_idx
#     on public.announcements (promotor_id);
#
#   -- 2) Asignar dueno a lo que ya estaba publicado.
#   -- Sin esto, las filas viejas quedan sin dueno: la app las sigue mostrando a
#   -- todos a proposito -descartarlas haria desaparecer de golpe lo ya escrito-
#   -- pero conviene repartirlas. Pon el UUID de tu promotor:
#   --
#   --   select id, email, role from public.profiles where role = 'promoter';
#   --
#   update public.announcements
#      set promotor_id = 'UUID-DEL-PROMOTOR'
#    where promotor_id is null;
#
#   -- 3) Quien firma cada comunicado.
#   --
#   -- `promotor_id` dice en QUE MURO aparece; `author_id` y `author_name`, QUIEN lo
#   -- escribio. Son dos cosas distintas y separarlas es lo que permite que varios
#   -- promotores publiquen en la misma promotoria: comparten muro y cada comunicado
#   -- lleva su firma.
#   --
#   -- El nombre se guarda junto al comunicado en lugar de leerse de `profiles` al
#   -- mostrarlo. No es por ahorrar una consulta: RLS no deja al asesor leer fichas
#   -- ajenas, asi que un join devolveria vacio justo para quien tiene que ver el
#   -- nombre. Y congelarlo es correcto: "publicado por" es un hecho de la fecha en
#   -- que se publico.
#   alter table public.announcements
#     add column if not exists author_id uuid references public.profiles(id),
#     add column if not exists author_name text;
#
#   -- A lo ya publicado se le pone como autor su propio dueno de muro, que es
#   -- quien lo escribio cuando habia un solo promotor por promotoria.
#   update public.announcements a
#      set author_id = a.promotor_id,
#          author_name = coalesce(
#            (select nullif(p.full_name, '') from public.profiles p where p.id = a.promotor_id),
#            'Promotoria'
#          )
#    where a.author_id is null
#      and a.promotor_id is not null;
#
#   -- 4) Recomendado: que la base tambien lo haga cumplir.
#   -- El filtro del cliente evita el error de ver lo ajeno, pero cualquiera con la
#   -- llave publica puede pedir la tabla entera desde la consola del navegador.
#   drop policy if exists "lectura publica" on public.announcements;
#
#   create policy "cada quien lee su muro" on public.announcements
#     for select to anon, authenticated
#     using (
#       promotor_id is null
#       or promotor_id = auth.uid()
#       or promotor_id = (
#         select promotor_id from public.profiles where id = auth.uid()
#       )
#     );
#
# ---------------------------------------------------------------------------
# ADJUNTOS (Supabase Storage). Los flyers y documentos del Workplace se suben
# al bucket "workplace-files". Sin él, la app avisa en su consola y guarda el
# comunicado sin archivo.
#
#   1) En el panel de Supabase: Storage > New bucket
#        Nombre: workplace-files
#        Public bucket: SÍ  (si queda privado, las URLs no abrirán)
#
#   2) Políticas sobre los objetos, en el editor SQL:
#
#      create policy "lectura publica de archivos"
#        on storage.objects for select
#        using (bucket_id = 'workplace-files');
#
#      -- OJO: igual que arriba, esto deja subir a cualquiera con la anon key.
#      create policy "subida de pruebas"
#        on storage.objects for insert
#        with check (bucket_id = 'workplace-files');
#
#   3) Y el privilegio de Postgres, igual que con las tablas: sin esto, subir
#      una foto de perfil falla con 42501 en cuanto hay sesión iniciada.
#
#      grant select, insert on storage.objects to anon, authenticated;


# ---------------------------------------------------------------------------
# ACCESO CON GOOGLE Y APROBACIÓN DE SOLICITUDES
#
# 1) En Google Cloud Console: crea un OAuth client de tipo "Web application".
#    Authorized redirect URI:
#      https://<tu-proyecto>.supabase.co/auth/v1/callback
#
# 2) En Supabase: Authentication > Providers > Google. Pega ahí el Client ID y
#    el Client Secret.
#    OJO: el secret va SOLO en ese panel. Nunca en este archivo ni en una
#    variable VITE_*, porque Vite las inyecta dentro del bundle que descarga el
#    navegador y quedarían a la vista de cualquiera.
#
# 3) En Supabase: Authentication > URL Configuration.
#      Site URL:      https://app-catador-seguros.vercel.app
#      Redirect URLs: https://app-catador-seguros.vercel.app
#                     http://localhost:5173
#
# 4) Tabla de perfiles, en el editor SQL:
#
#   create table if not exists public.profiles (
#     id         uuid primary key references auth.users(id) on delete cascade,
#     email      text,
#     full_name  text,
#     avatar_url text,
#     role       text not null default 'pending',
#     created_at timestamptz not null default now()
#   );
#
#   alter table public.profiles enable row level security;
#
#   -- Una política sobre `profiles` no puede consultar `profiles` sin provocar
#   -- recursión infinita. Esta función rompe el ciclo: al ser SECURITY DEFINER
#   -- lee la tabla sin volver a evaluar las políticas.
#   create or replace function public.my_role()
#     returns text
#     language sql
#     security definer
#     stable
#     set search_path = public
#   as $$ select role from public.profiles where id = auth.uid() $$;
#
#   -- Cada quien ve su propia ficha
#   create policy "leer mi perfil" on public.profiles
#     for select using (id = auth.uid());
#
#   -- Y la crea al entrar por primera vez, SIEMPRE como pending.
#   -- La condición `role = 'pending'` es la pieza de seguridad de todo esto:
#   -- sin ella, cualquiera podría registrarse otorgándose el rol de promotor
#   -- desde la consola del navegador.
#   create policy "crear mi perfil" on public.profiles
#     for insert with check (id = auth.uid() and role = 'pending');
#
#   -- Los promotores ven la lista y aprueban
#   create policy "promotores leen todo" on public.profiles
#     for select using (public.my_role() in ('promoter', 'admin'));
#
#   create policy "promotores aprueban" on public.profiles
#     for update using (public.my_role() in ('promoter', 'admin'));
#
# 5) EL PRIMER PROMOTOR se nombra a mano: entra una vez con Google (quedarás en
#    'pending') y luego, en el editor SQL:
#
#      update public.profiles set role = 'promoter' where email = 'tu@correo.com';
#
#    A partir de ahí ya puedes aprobar a los demás desde el panel de la app.


# ---------------------------------------------------------------------------
# JERARQUÍA DE ROLES (reemplaza la política de UPDATE anterior)
#
# Con la política inicial, cualquier promotor podía modificar CUALQUIER ficha,
# incluida la del administrador: un promotor podía degradar al dueño y quedarse
# con el control. Esto lo separa en dos niveles.
#
#   -- La política amplia anterior se retira
#   drop policy if exists "promotores aprueban" on public.profiles;
#
#   -- El administrador gestiona a cualquiera, menos a sí mismo. Excluirse es lo
#   -- que evita que se degrade por error y deje la promotoría sin quien apruebe.
#   create policy "administradores gestionan todo" on public.profiles
#     for update
#     using  (public.my_role() = 'admin' and id <> auth.uid())
#     with check (public.my_role() = 'admin');
#
#   -- El promotor sólo mueve asesores, y sólo entre roles no elevados.
#   -- `using` mira la fila ANTES del cambio: impide tocar a un promotor o
#   -- administrador existente.
#   -- `with check` mira la fila DESPUÉS: impide que otorgue esos roles.
#   create policy "promotores gestionan asesores" on public.profiles
#     for update
#     using  (
#       public.my_role() = 'promoter'
#       and id <> auth.uid()
#       and role in ('pending', 'advisor')
#     )
#     with check (role in ('pending', 'advisor'));
#
# Para nombrar al primer administrador, desde el editor SQL:
#
#   select email, full_name, role from public.profiles order by created_at;
#   update public.profiles set role = 'admin' where email = 'tu@correo.com';


# ---------------------------------------------------------------------------
# EL PRIMER ADMINISTRADOR, SIN TRÁMITE
#
# Problema del huevo y la gallina: la ficha se crea con role='pending' al entrar
# por primera vez, así que el dueño de la promotoría acaba esperando su propia
# aprobación y no hay nadie que pueda dársela.
#
# Este disparador resuelve el caso: si la tabla estaba vacía, quien entra
# primero queda como administrador. Va en la base y no en la app a propósito:
# hecho desde el navegador, cualquiera podría reclamar ese rol.
#
#   create or replace function public.promote_first_user()
#     returns trigger
#     language plpgsql
#     security definer
#     set search_path = public
#   as $$
#   begin
#     -- Vale 1 porque la fila recién insertada ya está contada: significa que
#     -- es la única de la tabla.
#     if (select count(*) from public.profiles) = 1 then
#       update public.profiles set role = 'admin' where id = new.id;
#     end if;
#     return null;
#   end $$;
#
#   create trigger profiles_promote_first
#     after insert on public.profiles
#     for each row execute function public.promote_first_user();
#
# Se usa AFTER INSERT y no BEFORE: la política de RLS exige role='pending' en su
# WITH CHECK, y esa comprobación ocurre después de los disparadores BEFORE. Uno
# BEFORE que pusiera 'admin' sería rechazado por la propia política.
#
# ---------------------------------------------------------------------------
# SI YA TIENES FILAS Y TE QUEDASTE EN ESPERA
#
# 1) Mira qué hay realmente en la tabla:
#
#      select id, email, role, created_at from public.profiles order by created_at;
#
# 2) Nómbrate administrador. OJO: 'admin' va en minúscula. Los roles distinguen
#    mayúsculas, y 'Admin' o 'ADMIN' dejan la cuenta fuera de la app.
#
#      update public.profiles set role = 'admin' where email = 'tu@correo.com';
#
#    Debe responder "Success. 1 row". Si dice 0 rows, el correo no coincide con
#    ninguna fila: revisa la lista del paso 1.
#
# 3) En la app, pulsa "Ya me aprobaron, revisar". El rol se relee sin recargar.


# ---------------------------------------------------------------------------
# TARJETA DIGITAL DEL ASESOR
#
# Añade a `profiles` las columnas de la tarjeta y, sobre todo, la política que
# permite a cada quien editar SU PROPIA ficha: las políticas anteriores sólo
# dejaban escribir a administradores y promotores, así que "Guardar Tarjeta"
# fallaba sin tocar ninguna fila.
#
#   alter table public.profiles
#     add column if not exists title       text,
#     add column if not exists license     text,
#     add column if not exists company     text,
#     add column if not exists specialties text[] default '{}',
#     add column if not exists bio         text,
#     add column if not exists phone       text,
#     add column if not exists whatsapp    text;
#
#   -- Cada quien edita su ficha
#   drop policy if exists "editar mi perfil" on public.profiles;
#   create policy "editar mi perfil" on public.profiles
#     for update
#     using (id = auth.uid())
#     with check (id = auth.uid());
#
# CUIDADO: esa política, sola, dejaría que cualquiera se cambiara su propio rol
# a 'admin' desde la consola del navegador. Una policy no puede comparar el
# valor anterior con el nuevo, así que la protección va en un disparador:
#
#   create or replace function public.protect_profile_role()
#     returns trigger
#     language plpgsql
#     security definer
#     set search_path = public
#   as $$
#   begin
#     -- Quien no administra conserva el rol que ya tenía, aunque mande otro.
#     if new.role is distinct from old.role
#        and public.my_role() not in ('admin', 'promoter') then
#       new.role := old.role;
#     end if;
#     return new;
#   end $$;
#
#   drop trigger if exists profiles_protect_role on public.profiles;
#   create trigger profiles_protect_role
#     before update on public.profiles
#     for each row execute function public.protect_profile_role();
#
# La foto se guarda en el bucket `workplace-files`, en la carpeta `perfiles/`.
# No hace falta crear otro bucket ni más políticas: las de lectura pública y
# subida que ya tiene cubren cualquier ruta dentro de él.


# ---------------------------------------------------------------------------
# PROSPECTOS CAPTURADOS (opcional)
#
# Hoy los prospectos que llenan el formulario de la tarjeta se guardan en el
# teléfono del asesor (localStorage), que es donde ocurre el intercambio: él
# presta el aparato, la persona escribe y él se queda con el dato. No hay sesión
# del prospecto, así que no hay a quién atribuir la fila.
#
# Eso significa que los prospectos NO se sincronizan entre dispositivos y se
# pierden si se borran los datos del navegador. Para llevarlos a Supabase:
#
#   create table if not exists public.leads (
#     id          uuid primary key default gen_random_uuid(),
#     advisor_id  uuid not null references public.profiles(id) on delete cascade,
#     name        text not null,
#     whatsapp    text,
#     created_at  timestamptz not null default now()
#   );
#
#   alter table public.leads enable row level security;
#   grant usage on schema public to anon, authenticated;
#   grant insert on public.leads to anon, authenticated;
#   grant select on public.leads to authenticated;
#
#   -- Cualquiera puede dejar sus datos: quien llena el formulario es el
#   -- prospecto y no tiene cuenta en la app.
#   create policy "dejar mis datos" on public.leads
#     for insert with check (true);
#
#   -- Pero sólo el asesor dueño los lee.
#   create policy "ver mis prospectos" on public.leads
#     for select using (advisor_id = auth.uid());
#
# OJO: con inserción abierta, cualquiera con la llave pública puede crear filas
# en esta tabla. Para un formulario de contacto es el compromiso habitual, pero
# conviene vigilar el volumen y añadir límite de frecuencia si se abusa.
#
# El cambio en la app se reduce a src/data/leads.js: es la única capa que sabe
# dónde viven los prospectos.



# ---------------------------------------------------------------------------
# VIDEO DE PRESENTACIÓN DE LA TARJETA (Cloudinary)
#
# El asesor sube un video de 10 segundos desde el editor de su tarjeta y aparece
# arriba del reverso, antes del botón de agendar.
#
#   VITE_CLOUDINARY_CLOUD_NAME=el-nombre-de-tu-nube
#   VITE_CLOUDINARY_VIDEO_PRESET=tarjetas_video
#
# El preset es opcional: si no se define, se usa "tarjetas_video".
#
# ¿POR QUÉ NO EL BUCKET DE SUPABASE, QUE YA ESTÁ MONTADO?
# Por el formato, no por el espacio. Un video grabado con iPhone sale en HEVC
# dentro de un .mov y ese códec no se reproduce en Chrome ni en la mayoría de los
# Android. Guardado tal cual, el asesor vería su video perfecto en su teléfono y
# sus prospectos un cuadro negro: el peor de los fallos, porque quien publica no
# puede detectarlo. Cloudinary transcodifica a H.264 al recibirlo y entrega el
# formato que cada navegador entienda (f_auto/q_auto). De paso, el tráfico de los
# videos no se come el de Supabase, del que dependen las fotos y los comunicados.
#
# CONFIGURACIÓN EN CLOUDINARY (una sola vez):
#
#   1) Settings > Upload > Upload presets > "Add upload preset"
#        Signing mode: Unsigned          <- imprescindible, la subida va desde
#                                           el navegador y no hay backend que firme
#        Preset name:  tarjetas_video
#        Folder:       tarjetas          <- mantiene los videos separados
#
#   2) En ese mismo preset, límites (importan: un preset "unsigned" queda
#      expuesto en el bundle, así que quien lo tenga puede subir):
#        Max file size:        60000000   (60 MB)
#        Max video duration:   12         (segundos; la app ya avisa a los 10)
#        Allowed formats:      mp4, mov, webm, m4v
#
#   3) El nombre de la nube está arriba a la derecha del panel, en "Cloud name".
#
# EN VERCEL:
#   Settings > Environment Variables > añade VITE_CLOUDINARY_CLOUD_NAME.
#   Las variables VITE_* se inyectan al construir, así que hay que volver a
#   desplegar (Deployments > ... > Redeploy) para que el cambio surta efecto.
#
# EN LA BASE (la columna donde se guarda la dirección):
#
#   alter table public.profiles add column if not exists video_url text;
#
#   drop view if exists public.public_cards cascade;
#   create view public.public_cards as
#     select id, full_name, title, company, specialties, bio,
#            phone, email, whatsapp, avatar_url, photo_focus, video_url
#     from public.profiles
#     where role in ('advisor','promoter','admin');
#   grant select on public.public_cards to anon, authenticated;
#
# Sin la columna, la app sigue funcionando: el guardado se reintenta sin ella
# (OPTIONAL_COLUMNS en profilesRepo.js) y el video simplemente no persiste.



# ---------------------------------------------------------------------------
# PROMOTORÍAS: RELACIÓN PROMOTOR–ASESOR Y CÓDIGO DE INVITACIÓN
#
# Un promotor genera su código (forma MAC-866-08: iniciales del nombre de la
# promotoría + 5 dígitos) y lo comparte. El asesor lo escribe, queda en espera y
# el promotor lo aprueba o lo rechaza desde "Ver más > Mi Promotoría".
#
#   -- 1) Las tres columnas
#   alter table public.profiles
#     add column if not exists promotor_id uuid
#       references public.profiles(id) on delete set null,
#     add column if not exists promotoria_status text,
#     add column if not exists promotoria_code text;
#
#   -- El índice va sobre upper(): sin eso, "mac-866-08" y "MAC-866-08" serían
#   -- dos promotorías distintas.
#   -- El indice ignora los nulos por si solo, pero NO las cadenas vacias: dos
#   -- promotorias con '' chocarian entre si y la segunda veria "ese codigo ya lo
#   -- usa otra promotoria" sin haber escrito nada. Se excluyen las dos.
#   drop index if exists profiles_promotoria_code_key;
#   create unique index if not exists profiles_promotoria_code_key
#     on public.profiles (upper(promotoria_code))
#     where promotoria_code is not null and promotoria_code <> '';
#
#   -- 2) El promotor ve a su equipo, y sólo a su equipo
#   drop policy if exists "promotores leen su equipo" on public.profiles;
#   create policy "promotores leen su equipo" on public.profiles
#     for select using (promotor_id = auth.uid());
#
#   -- 3) Y responde las solicitudes de su equipo
#   drop policy if exists "promotores gestionan su equipo" on public.profiles;
#   create policy "promotores gestionan su equipo" on public.profiles
#     for update using (promotor_id = auth.uid());
#
#   -- 4) CRÍTICO: nadie se aprueba a sí mismo.
#   -- Cada quien puede editar su propio perfil (policy "editar mi perfil"), así
#   -- que sin este disparador un asesor se pondría promotoria_status='approved'
#   -- desde la consola del navegador. Limpiar las columnas sí está permitido:
#   -- es lo que hace "Cancelar mi solicitud".
#   create or replace function public.protect_promotoria()
#     returns trigger language plpgsql security definer set search_path = public
#   as $$
#   begin
#     if new.promotoria_status is distinct from old.promotoria_status
#        and new.promotoria_status = 'approved'
#        and auth.uid() <> coalesce(new.promotor_id, old.promotor_id)
#        and public.my_role() <> 'admin' then
#       new.promotoria_status := old.promotoria_status;
#     end if;
#     return new;
#   end $$;
#
#   drop trigger if exists profiles_protect_promotoria on public.profiles;
#   create trigger profiles_protect_promotoria
#     before update on public.profiles
#     for each row execute function public.protect_promotoria();
#
#   -- 5) Unirse con un código, SIN poder leer fichas ajenas.
#   -- Para buscar al promotor por su código, el asesor necesitaría permiso de
#   -- lectura sobre toda la tabla, y con él podría listar los correos de la
#   -- promotoría entera desde el navegador. Esta función corre con los
#   -- privilegios de la base, recibe sólo el código y devuelve sólo el nombre.
#   -- OJO con los nombres de las columnas de salida.
#   --
#   -- `returns table (promotor_id ...)` declara una variable de salida con ese
#   -- nombre, y dentro del cuerpo pasa a competir con la columna real de la
#   -- tabla: Postgres responde "column reference promotor_id is ambiguous"
#   -- (42702) y la union falla. Por eso la salida se llama `promotor` y todas
#   -- las referencias a la tabla van con alias `p.`, y las variables locales
#   -- llevan prefijo `v_`.
#   -- OJO: si ya existe una version anterior con otros nombres de salida,
#   -- `create or replace` falla con 42P13 ("cannot change return type of existing
#   -- function"). Postgres no permite cambiar el tipo de la fila devuelta, asi que
#   -- hay que borrarla primero. Con `if exists` es seguro en una base nueva.
#   drop function if exists public.join_promotoria(text);
#
#   create or replace function public.join_promotoria(p_code text)
#     returns table (promotor uuid, promotoria text)
#     language plpgsql security definer set search_path = public
#   as $$
#   declare v_target_id uuid; v_target_name text;
#   begin
#     select p.id, coalesce(nullif(p.company, ''), p.full_name)
#       into v_target_id, v_target_name
#       from public.profiles p
#      where upper(p.promotoria_code) = upper(trim(p_code))
#        and p.role = 'promoter'
#      limit 1;
#
#     if v_target_id is null then raise exception 'CODIGO_NO_EXISTE'; end if;
#     if v_target_id = auth.uid() then raise exception 'ES_TU_PROPIO_CODIGO'; end if;
#
#     -- Un bloqueo tiene que aguantar: sin esto, quien fue bloqueado escribe el
#     -- codigo otra vez y su solicitud reaparece en la cola del promotor.
#     if exists (
#       select 1 from public.profiles p
#        where p.id = auth.uid()
#          and p.promotor_id = v_target_id
#          and p.promotoria_status = 'blocked'
#     ) then
#       raise exception 'BLOQUEADO';
#     end if;
#
#     update public.profiles p
#        set promotor_id = v_target_id, promotoria_status = 'pending'
#      where p.id = auth.uid();
#
#     return query select v_target_id, v_target_name;
#   end $$;
#
#   grant execute on function public.join_promotoria(text) to authenticated;
#
#   -- 6) Que el asesor sepa a que promotoria pertenece.
#   --
#   -- Hace falta una funcion porque RLS no le deja leer la ficha de su promotor:
#   -- solo ve la suya. Sin esto, el muro no puede mostrarle el nombre de la
#   -- promotoria a la que acaba de entrar. Devuelve el nombre y nada mas, asi que
#   -- no sirve para averiguar quien mas esta dentro.
#   create or replace function public.my_promotoria()
#     returns table (promotor uuid, promotoria text, estado text)
#     language sql security definer set search_path = public
#   as $$
#     select pr.id,
#            coalesce(nullif(pr.company, ''), pr.full_name),
#            me.promotoria_status
#       from public.profiles me
#       join public.profiles pr on pr.id = me.promotor_id
#      where me.id = auth.uid();
#   $$;
#
#   grant execute on function public.my_promotoria() to authenticated;
#
# ASIGNACIÓN A MANO (mientras se prueba, sin usar el código):
#
#   select id, email, role from public.profiles order by created_at;
#
#   update public.profiles
#      set promotor_id = 'UUID-DEL-PROMOTOR', promotoria_status = 'pending'
#    where email = 'asesor@ejemplo.com';
#
# OJO: el rol se guarda en inglés ('advisor', 'promoter'). Consultar por 'asesor'
# o 'promotor' devuelve cero filas sin lanzar ningún error.
#
# ---------------------------------------------------------------------------
# PRESENCIA: "EN LÍNEA" EN EL PANEL DEL PROMOTOR
#
# La app escribe `last_seen` al entrar y cada cinco minutos mientras la pestaña
# esté a la vista. El panel muestra "En línea" si hay menos de 15 minutos, y
# "Hace X" si hay más.
#
#   alter table public.profiles
#     add column if not exists last_seen timestamptz;
#
# No se usa auth.users.last_sign_in_at por dos razones: sólo se lee con la llave
# de servicio, y marca el inicio de sesión —que en un móvil ocurre una vez y no
# se repite en semanas—, no la actividad real.
#
# Cada quien escribe su propio `last_seen` con la política "editar mi perfil"
# que ya existe, así que no hace falta ninguna política nueva.
#
# Si esta columna no existe, el equipo se sigue viendo: la consulta se reintenta
# sin ella y las tarjetas muestran "Sin actividad" en lugar del estado.
